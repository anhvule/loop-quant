{
  "_comment": "HARD safety limits. NEVER writable by the optimizer LLM. Any parameter absent from `params` is immutable to the optimizer by construction (ProposalValidator rejects paths not listed here). Re-enforced on every config load so even a hand-corrupted config.json cannot start the engine.",

  "max_delta_pct_per_cycle": 25,
  "max_params_per_cycle": 3,

  "params": {
    "strategy.weights.vwap":            { "min": 0.0,  "max": 1.0 },
    "strategy.weights.rsi":             { "min": 0.0,  "max": 1.0 },
    "strategy.weights.macd":            { "min": 0.0,  "max": 1.0 },
    "strategy.entry_threshold":         { "min": 0.2,  "max": 0.9 },
    "strategy.exit_threshold":          { "min": -0.9, "max": 0.0 },
    "strategy.rsi.oversold":            { "min": 15,   "max": 40 },
    "strategy.rsi.overbought":          { "min": 60,   "max": 85 },
    "strategy.vwap_band_bps":           { "min": 5,    "max": 50 },
    "risk.atr_mult_sl":                 { "min": 0.5,  "max": 3.0 },
    "risk.atr_mult_tp":                 { "min": 1.0,  "max": 6.0 },
    "risk.risk_per_trade_pct":          { "min": 0.1,  "max": 1.0 },
    "risk.cooldown_after_stopout_sec":  { "min": 60,   "max": 3600 },
    "execution.limit_timeout_sec":      { "min": 2,    "max": 30 },
    "execution.max_spread_bps":         { "min": 2,    "max": 20 }
  },

  "invariants": [
    {
      "id": "rr_floor",
      "expr": "risk.atr_mult_tp >= 1.2 * risk.atr_mult_sl",
      "message": "Take-profit distance must be at least 1.2x the stop distance; a lower R:R makes the breakeven win rate unreachable."
    },
    {
      "id": "rsi_band_ordering",
      "expr": "strategy.rsi.overbought > strategy.rsi.oversold + 10",
      "message": "RSI overbought must sit at least 10 points above oversold."
    },
    {
      "id": "weights_nonzero",
      "expr": "strategy.weights.vwap + strategy.weights.rsi + strategy.weights.macd > 0",
      "message": "At least one strategy weight must be non-zero or no signal can ever fire."
    },
    {
      "id": "threshold_ordering",
      "expr": "strategy.entry_threshold > strategy.exit_threshold",
      "message": "Entry threshold must exceed exit threshold or entries and exits fire simultaneously."
    }
  ]
}
